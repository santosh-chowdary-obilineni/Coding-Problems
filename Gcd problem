class Solution {
  public:
   int Gcd(int a, int b){
       if(b == 0) return a;
       return Gcd(b , a % b);
   }
   
    int gcd(int n, vector<int> arr) {
        // Your code goes here
        int ans = arr[0];
        for(int i = 1;i < arr.size(); i++){
            ans = Gcd(ans , arr[i]);
        }
        return ans;
    }
};

